PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/precedentiq
PGSSLMODE=require
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12
GEMINI_API_KEY=replace_with_your_gemini_api_key
UPLOAD_DIR=/var/data/precedentiq/uploads
MAX_UPLOAD_MB=50
CLIENT_ORIGIN=http://localhost:5173
